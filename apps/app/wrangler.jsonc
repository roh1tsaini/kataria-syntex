{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The worker answers /api/*; every other path that misses a static file
    // serves index.html so SPA deep links (e.g. /challans) work.
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ks-biz-app-db",
      // CI auto-provisions the database and injects the real id on deploy
      // (.github/workflows/cf-deploy.yml). Local dev works as-is with the
      // placeholder — wrangler backs it with a local SQLite database.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle",
      "migrations_pattern": "drizzle/*/migration.sql",
    },
  ],
  "r2_buckets": [
    {
      "binding": "RELEASES",
      // Installers, APK and update manifests under app/ — served publicly at
      // /releases/* by the worker (src/server/lib/releases.ts). CI ensures
      // the bucket exists before deploying (.github/workflows/cf-deploy.yml),
      // mirroring the D1 flow; local dev simulates it with the same name.
      "bucket_name": "ks-releases",
    },
  ],
  "vars": {
    // Non-secret config. Secrets (PINGRAM_API_KEY etc.) live in .dev.vars
    // locally and `wrangler secret put` in production.
    "OTP_DAILY_BUDGET": "300",
  },
}
