{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kataria-app",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kataria-app",
      // CI auto-provisions the database and injects the real id on deploy
      // (.github/workflows/cf-deploy.yml). Local dev (wrangler pages dev)
      // works as-is with the placeholder.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle",
      "migrations_pattern": "drizzle/*/migration.sql",
    },
  ],
  "vars": {
    // Non-secret config. Secrets (PINGRAM_API_KEY etc.) live in .dev.vars
    // locally and `wrangler pages secret` in prod.
    "OTP_DAILY_BUDGET": "300",
  },
}
