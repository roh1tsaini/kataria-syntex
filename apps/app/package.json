{
  "name": "@kataria-syntex/biz-app",
  "version": "0.6.3",
  "minAppVersion": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:server": "wrangler dev --port 3000",
    "build": "bunx vite build",
    "typecheck": "bunx tsc --noEmit && bunx tsc -p tsconfig.server.json --noEmit && bunx tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply ks-biz-app-db --local",
    "icons": "bun scripts/generate-icons.ts",
    "electron:dev": "bun electron/dev.ts",
    "build:electron": "bun electron/build.ts",
    "electron:package": "bun run build && bun run build:electron && bunx electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@kataria-syntex/app-core": "*",
    "@kataria-syntex/shared": "*",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "class-variance-authority": "^0.7.1",
    "drizzle-orm": "^1.0.0-rc.4",
    "electron-updater": "^6.8.9",
    "hono": "^4.12.33",
    "input-otp": "^1.4.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "qr-code-styling": "^1.9.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.8",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@kataria-syntex/tsconfig": "*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.1.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "drizzle-kit": "^1.0.0-rc.4",
    "electron": "43.6.0",
    "electron-builder": "^26.0.0",
    "eslint": "~9.38.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.127.1"
  },
  "engines": {
    "bun": ">=1.1"
  }
}
