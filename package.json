{
  "name": "kataria-syntex-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@kataria-syntex/web",
    "dev:app": "turbo dev --filter=@kataria-syntex/challan-app",
    "build": "turbo build",
    "build:web": "turbo build --filter=@kataria-syntex/web",
    "build:app": "turbo build --filter=@kataria-syntex/challan-app",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "sharp": "0.35.3"
  }
}
